# PostgreSQL obligatorio en hosting serverless. Usa SSL verificado según tu proveedor.
DATABASE_URL=
# Alternativa para servidor con disco persistente; desarrollo usa .data/catalog.json.
CATALOG_DATA_FILE=

# Origen público exacto, sin ruta ni barra final.
# Dominio previsto: https://suvenirssaltillo.shop (activar tras verificar DNS/HTTPS).
# En desarrollo: http://localhost:3000. Ver docs/custom-domain.md.
APP_ORIGIN=
# WhatsApp público del negocio, con código de país (solo dígitos).
WHATSAPP_NUMBER=
# Administración: contraseña >=12 caracteres y secreto independiente >=32.
ADMIN_PASSWORD=
AUTH_SECRET=

# Política de precios
DEFAULT_MARGIN_PERCENT=40

# Monitor: secreto independiente >=32. MONITOR_URL solo se usa en GitHub Actions.
MONITOR_SECRET=
MONITOR_URL=
MONITOR_BATCH_SIZE=2
# light: una revisión por solicitud web; las alternativas se buscan en el worker.
# Configurar light en Netlify para respetar el tiempo de las funciones web.
MONITOR_WEB_MODE=full
# Marcar true solo después de configurar el scheduler del hosting.
MONITOR_SCHEDULER_CONFIGURED=false

# Opcional: búsqueda automática de alternativas. Tavily usa basic (1 crédito).
# Sin estos valores, el panel conserva la opción de agregar enlaces manualmente.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# Consultas por mes UTC de esta tienda; máximo 900. Fallos también reservan cupo.
SEARCH_MONTHLY_LIMIT=900

# El bot extrae JSON-LD/metadatos y guarda URLs de imágenes; no invoca un LLM.
# Alojar copias de imágenes requiere adaptar el almacenamiento de la tienda.
